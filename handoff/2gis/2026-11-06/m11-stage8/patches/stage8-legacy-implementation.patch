+
+export function section15TariffsAt(date: Date) {
+  return activeSection15Snapshot(date).tariffs;
+}
+
+function section15Profile(date: Date, snapshot = activeSection15Snapshot(date)): Section15Profile {
+  const currentParts = moscowParts(date);
+  // The 06:00–01:00 tariff window is named for the day on which it starts.
+  // Thus 00:00–00:59 belongs to the previous day's profile.
+  const profileDate = currentParts.hour < 1 ? new Date(date.getTime() - 60 * 60 * 1000) : date;
