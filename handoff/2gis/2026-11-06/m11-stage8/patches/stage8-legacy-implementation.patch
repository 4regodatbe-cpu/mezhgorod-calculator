+import novemberSection15Snapshot from "../../data/tolls/m11/2026-11-02-section15-58-category1-no-transponder.json" with { type: "json" };
 
 type Section15Profile = "monThu" | "friday" | "saturday" | "sunday";
 
@@ -12,9 +13,23 @@ function moscowParts(date: Date) {
