{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "fix-systemic-toll-composition": false
    }
  },
  "functions": {
    "app/api/suggest/route.ts": {
      "regions": ["fra1"],
      "supportsCancellation": true
    },
    "app/r/route.ts": {
      "regions": ["fra1"],
      "supportsCancellation": true
    }
  }
}
